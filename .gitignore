.venv/
venv/
Python/
**/__pycache__/
*.py[cod]
.pytest_cache/
.pytest-*/
.test-*/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Frontend dependencies and builds
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Runtime data
users.json
chat_history.json
data/

# Evaluation inputs and generated output
evaluations/datasets/downloaded/*
evaluations/datasets/normalized/*
