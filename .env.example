OPENAI_API_KEY=your_openai_api_key_here
# Optional separate key/project for evaluation generation and graders.
EVAL_API_KEY=
EVAL_GENERATOR_MODEL=gpt-5.4-mini
EVAL_PRIMARY_GRADER_MODEL=gpt-5.6-luna
EVAL_ADJUDICATOR_MODEL=gpt-5.4-mini
EVAL_RAG_METRICS_MODEL=gpt-5.6-luna
EVAL_FALLBACK_MODEL=gpt-5.6-luna
EVAL_QUERY_EXPANSION_ENABLED=true
EVAL_REGRADE_WORKERS=8
EVAL_RAG_REGRADE_WORKERS=12
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
SHADOW_MODE_ENABLED=false
FLYNNMED_RELEASE_ID=unfrozen-development
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Required (Postgres). Local dev: docker compose up -d db, then
# postgresql+psycopg://flynnmed:flynnmed_dev_only@localhost:5432/flynnmed
DATABASE_URL=
# Required for clinician/patient consent and relational patient records.
# Migrate legacy JSON data before switching an existing deployment.
DATA_BACKEND=sql

# Seeds fictional public demo accounts after migrations. This is off by
# default and must only be enabled for an isolated demonstration database.
SEED_DEMO_ACCOUNTS=false

# Required in production (ENVIRONMENT=production) -- app refuses to start
# without it. In development, an ephemeral random secret is used if unset
# (sessions won't survive a restart).
JWT_SECRET_KEY=
ENVIRONMENT=development
RATE_LIMITING_ENABLED=false

# Production PHI processor policy. Explicitly approve the processor host and
# every generation/embedding/transcription model the deployment uses.
LLM_PHI_PROCESSING_ALLOWED=false
LLM_APPROVED_HOSTS=api.openai.com
LLM_APPROVED_MODELS=gpt-5.4-mini,text-embedding-3-small,gpt-image-1,whisper-1,sora-2

# Out-of-band key used only by the clinician credential review endpoint.
CLINICIAN_VERIFICATION_ADMIN_KEY=

# One-release data import switch for scripts/release.sh only.
MIGRATE_LEGACY_ACCOUNTS=false

# Privileged integration surface. Disabled unless explicitly enabled. When
# enabled, clients must send a FlynnMed account JWT; patient self-access and
# clinician consent are enforced by every patient-record tool.
MCP_ENABLED=false
MCP_AUTH_MODE=jwt


SMTP_HOST=smtp.gmail.com
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
